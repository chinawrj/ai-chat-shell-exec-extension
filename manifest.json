{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "AI Chat Shell Exec",
  "description": "Runs explicit ai-helper shell blocks, loads local Skills safely, and previews complete ai-helper Draw.io files locally as SVG.",
  "version": "0.11.10",
  "key": "",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://127.0.0.1:17371/*",
    "ws://127.0.0.1:17371/*"
  ],
  "background": {
    "service_worker": "extension/src/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; child-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "sandbox": {
    "pages": [
      "extension/drawio/viewer.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "extension/drawio/viewer.html",
        "extension/drawio/viewer.css",
        "extension/drawio/viewer.js",
        "extension/vendor/drawio/viewer-static.min.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "extension/src/drawio-preview.js",
        "extension/src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI Chat Shell Exec",
    "default_popup": "extension/popup.html"
  }
}
